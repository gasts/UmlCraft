class Node Public
  attribute + self : Node&
  attribute + list : Node**
  attribute + buffer : int[16]
  attribute + name : char[32 + 1]
  attribute + label : const char*
  attribute + a : int*
  attribute + b : int
  attribute + c : int& = b
  operation + moved(other : Node&&) : Node&&
  operation + fill(values : int[], count : int,  : ...) : void
  association Node NonNavigable -- Node Navigable next Public [0..1]
    @umlcraft.imported = "true"
