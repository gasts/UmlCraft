    attribute + untyped = 1 {static}
    attribute + count : int = 0 {static}
    attribute + limit : int = 10 {readOnly}
    attribute + frozen = "x" {readOnly}
    attribute + either : int | str
    attribute + callback : Callable<[int],str>
    operation + apply(x, y : int, z : Line = None) : Hints
