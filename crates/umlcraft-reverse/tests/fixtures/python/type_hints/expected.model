    association hints.Hints NonNavigable -- hints.Line Navigable union Public [0..1]
      @umlcraft.imported = "true"
    association hints.Hints NonNavigable -- hints.Line Navigable forward Public
      @umlcraft.imported = "true"
    association hints.Hints NonNavigable -- hints.Line Navigable forward_list Public [*] {ordered}
      @umlcraft.imported = "true"
